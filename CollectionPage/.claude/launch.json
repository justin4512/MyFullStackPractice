{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "folio",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": ["-S", "127.0.0.1:8321", "-t", "."],
      "port": 8321
    },
    {
      "name": "design-mac",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8321", "--bind", "127.0.0.1"],
      "port": 8321
    },
    {
      "name": "repo-root",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8330", "--bind", "127.0.0.1", "--directory", ".."],
      "port": 8330
    },
    {
      "name": "showcase",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "showcase", "run", "dev"],
      "port": 5173
    }
  ]
}
