{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/projects.schema.json",
  "title": "Portfolio projects",
  "description": "作品輯資料契約。權威定義見 README.md 第 4 部 §2。",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/Project" }
    }
  },
  "$defs": {
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "role", "problem", "visual"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "穩定 slug；用於 URL / history.state / DOM。發布後不可變更（FR-1.6）"
        },
        "order": { "type": "integer", "minimum": 1, "description": "排序值，小→大（DR-1）" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 80, "description": "掃讀層摘要 ≤ 80 字（FR-3.4）" },
        "year": { "type": ["integer", "null"] },
        "categories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "role": { "$ref": "#/$defs/Role" },
        "problem": { "$ref": "#/$defs/Problem" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/Decision" } },
        "tech": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/Outcome" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/Link" } },
        "visual": { "$ref": "#/$defs/Visual" },
        "visuals": { "type": "array", "items": { "$ref": "#/$defs/Visual" } },
        "deepDive": { "$ref": "#/$defs/DeepDive" },
        "confidentiality": { "$ref": "#/$defs/Confidentiality" }
      }
    },
    "Role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "scope"],
      "description": "必須區分「我」與「團隊」（FR-3.1）",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1, "description": "我實際負責的範圍" },
        "team": { "type": "string", "description": "團隊組成與其他人的貢獻" }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "goal"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "description": "證據強度模型（FR-3.5）。條件約束由 validate-projects.mjs 強制。",
      "properties": {
        "type": { "enum": ["measured", "observed", "qualitative", "delivered", "unmeasured"] },
        "text": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "source": { "type": "string" },
        "measuredAt": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "measured" } }, "required": ["type"] },
          "then": { "required": ["value", "unit", "source", "measuredAt"] }
        },
        {
          "if": { "properties": { "type": { "const": "unmeasured" } }, "required": ["type"] },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ]
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "kind"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "description": "必須說明用途，不得為「看更多」" },
        "href": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["demo", "source", "case-study", "article"] },
        "external": { "type": "boolean" }
      }
    },
    "Visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "width", "height"],
      "description": "width/height 必填——沒有尺寸就無法保證 CLS（FR-2.8）",
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1, "description": "須具資訊量（FR-3.7）" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "srcset": { "type": "string" },
        "placeholder": { "type": "string", "description": "LQIP，可為 data URI" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "DeepDive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": { "type": "string", "minLength": 300, "maxLength": 500, "description": "300–500 字（FR-3.6）。上限依 README §0.9 行動 #6 由 2000 收斂為 500。" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "body"],
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "Confidentiality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted"],
      "properties": {
        "redacted": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "clientUnderNda": { "type": "boolean" }
      },
      "if": { "properties": { "redacted": { "const": true } }, "required": ["redacted"] },
      "then": { "required": ["reason"] }
    }
  }
}
